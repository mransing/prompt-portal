# Copy to .env (do not commit secrets). Load into shell or process before start.

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/promptportal

# --- API ---
SERVER_PORT=8080
APP_URL=http://localhost:3000
APP_DEV_MODE=true
ALLOWED_EMAILS=
AUTH_SECRET=change-me-to-a-long-random-string

# OAuth (optional; requires --spring.profiles.active=oauth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Storage & limits
UPLOAD_DIR=C:/prompt-portal-data/uploads
LOG_DIR=C:/prompt-portal-data/logs
MAX_UPLOAD_BYTES=2097152
QUOTA_BYTES=52428800
LOG_LEVEL=INFO
PERF_SLOW_MS=2000
RETENTION_ENABLED=true
RETENTION_DAYS=730

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEV_USER_EMAIL=you@example.com
